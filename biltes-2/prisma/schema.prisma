// BİLTES Koleji — veri modeli
// Çok dilli alanlar JSON olarak {"tr": "...", "en": "..."} biçiminde saklanır (bkz. lib/i18n.ts).
// Rol/izin eşlemesi lib/permissions.ts içindedir ve sunucu tarafında zorlanır.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  CONTENT_EDITOR
  CAMPUS_MANAGER
  ADMISSIONS
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LeadStatus {
  NEW
  CONTACTED
  APPOINTMENT
  MET
  ENROLLING
  CLOSED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(CONTENT_EDITOR)
  active       Boolean   @default(true)
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  campuses      Campus[]         @relation("CampusManagers")
  sessions      Session[]
  resets        PasswordReset[]
  assignedLeads Lead[]           @relation("LeadAssignee")
  notes         LeadNote[]
  audits        AuditLog[]
  articles      NewsArticle[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model PasswordReset {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model RateLimit {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
}

model Page {
  id          String        @id @default(cuid())
  slug        String
  parentId    String?
  parent      Page?         @relation("PageTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Page[]        @relation("PageTree")
  group       String        @default("kurumsal")
  title       Json
  summary     Json?
  blocks      Json          @default("[]") // {tr: Block[], en: Block[]}
  coverId     String?
  cover       MediaAsset?   @relation(fields: [coverId], references: [id], onDelete: SetNull)
  seo         Json?
  status      PublishStatus @default(DRAFT)
  publishAt   DateTime?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  revisions   PageRevision[]

  @@unique([group, slug])
  @@index([status, publishAt])
}

model PageRevision {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  snapshot  Json
  authorId  String?
  createdAt DateTime @default(now())

  @@index([pageId, createdAt])
}

model Campus {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  location    Json?
  description Json?
  address     String?
  phone       String?
  email       String?
  mapEmbedUrl String?
  mapLinkUrl  String?
  videoUrl    String?
  levels      String[]      @default([])
  features    Json?         // {tr: string[], en: string[]}
  mainImageId String?
  mainImage   MediaAsset?   @relation("CampusMain", fields: [mainImageId], references: [id], onDelete: SetNull)
  gallery     CampusGallery[]
  managers    User[]        @relation("CampusManagers")
  status      PublishStatus @default(DRAFT)
  sortOrder   Int           @default(0)
  seo         Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  leads       Lead[]
  events      Event[]
  articles    NewsArticle[]
}

model CampusGallery {
  id        String     @id @default(cuid())
  campusId  String
  campus    Campus     @relation(fields: [campusId], references: [id], onDelete: Cascade)
  mediaId   String
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  caption   Json?
  sortOrder Int        @default(0)

  @@index([campusId, sortOrder])
}

model EducationProgram {
  id          String        @id @default(cuid())
  slug        String        @unique
  level       String        // anaokulu | ilkokul | ortaokul | diger
  title       Json
  summary     Json?
  body        Json?         // {tr: Block[], en: Block[]}
  imageId     String?
  image       MediaAsset?   @relation(fields: [imageId], references: [id], onDelete: SetNull)
  status      PublishStatus @default(DRAFT)
  sortOrder   Int           @default(0)
  seo         Json?
  updatedAt   DateTime      @updatedAt
  createdAt   DateTime      @default(now())
}

model NewsCategory {
  id       String        @id @default(cuid())
  slug     String        @unique
  name     Json
  articles NewsArticle[]
}

model NewsArticle {
  id          String        @id @default(cuid())
  slug        String        @unique
  kind        String        @default("haber") // haber | duyuru
  title       Json
  excerpt     Json?
  body        Json?         // {tr: html, en: html}
  coverId     String?
  cover       MediaAsset?   @relation(fields: [coverId], references: [id], onDelete: SetNull)
  categoryId  String?
  category    NewsCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  campusId    String?
  campus      Campus?       @relation(fields: [campusId], references: [id], onDelete: SetNull)
  authorId    String?
  author      User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  tags        String[]      @default([])
  featured    Boolean       @default(false)
  status      PublishStatus @default(DRAFT)
  publishAt   DateTime?
  seo         Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishAt])
}

model Event {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       Json
  description Json?
  startsAt    DateTime
  endsAt      DateTime?
  location    String?
  campusId    String?
  campus      Campus?       @relation(fields: [campusId], references: [id], onDelete: SetNull)
  imageId     String?
  image       MediaAsset?   @relation(fields: [imageId], references: [id], onDelete: SetNull)
  registerUrl String?
  status      PublishStatus @default(DRAFT)
  seo         Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, startsAt])
}

model Achievement {
  id        String        @id @default(cuid())
  category  String        @default("akademik") // akademik | yarisma | sanat-spor | proje | kurumsal
  title     Json
  summary   Json?
  year      Int?
  imageId   String?
  image     MediaAsset?   @relation(fields: [imageId], references: [id], onDelete: SetNull)
  status    PublishStatus @default(DRAFT)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
}

model Club {
  id        String        @id @default(cuid())
  slug      String        @unique
  kind      String        @default("kulup") // kulup | atolye | spor | sanat
  title     Json
  summary   Json?
  imageId   String?
  image     MediaAsset?   @relation(fields: [imageId], references: [id], onDelete: SetNull)
  status    PublishStatus @default(DRAFT)
  sortOrder Int           @default(0)
}

model Testimonial {
  id        String        @id @default(cuid())
  author    String
  relation  Json?         // "Veli" vb.
  quote     Json
  campusId  String?
  photoId   String?
  photo     MediaAsset?   @relation(fields: [photoId], references: [id], onDelete: SetNull)
  videoUrl  String?
  consent   Boolean       @default(false) // yayın izni alındı
  status    PublishStatus @default(DRAFT)
  sortOrder Int           @default(0)
}

model HeroSlide {
  id          String        @id @default(cuid())
  title       Json
  subtitle    Json?
  ctaLabel    Json?
  ctaUrl      String?
  desktopId   String?
  desktop     MediaAsset?   @relation("HeroDesktop", fields: [desktopId], references: [id], onDelete: SetNull)
  mobileId    String?
  mobile      MediaAsset?   @relation("HeroMobile", fields: [mobileId], references: [id], onDelete: SetNull)
  videoUrl    String?
  overlay     Int           @default(45) // 0-90
  enabled     Boolean       @default(true)
  publishAt   DateTime?
  unpublishAt DateTime?
  sortOrder   Int           @default(0)
}

model HomeSection {
  key       String   @id // about | pillars | programs | campuses | approach | life | achievements | news | testimonials | cta
  data      Json     // yayınlanmış içerik
  draft     Json?    // taslak
  visible   Boolean  @default(true)
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt
}

model MediaAsset {
  id        String   @id @default(cuid())
  key       String   @unique       // depolama anahtarı
  url       String                 // genel URL
  webpUrl   String?
  kind      String   @default("image") // image | document
  mime      String
  size      Int
  width     Int?
  height    Int?
  alt       Json?
  folder    String   @default("genel")
  name      String
  createdAt DateTime @default(now())

  pages        Page[]
  campusMain   Campus[]          @relation("CampusMain")
  campusGallery CampusGallery[]
  programs     EducationProgram[]
  articles     NewsArticle[]
  events       Event[]
  achievements Achievement[]
  clubs        Club[]
  testimonials Testimonial[]
  heroDesktop  HeroSlide[]       @relation("HeroDesktop")
  heroMobile   HeroSlide[]       @relation("HeroMobile")

  @@index([folder])
}

model Menu {
  id    String     @id // header | utility | footer-quick | footer-legal
  name  String
  items MenuItem[]
}

model MenuItem {
  id        String     @id @default(cuid())
  menuId    String
  menu      Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    MenuItem?  @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  MenuItem[] @relation("MenuTree")
  label     Json
  url       String
  external  Boolean    @default(false)
  enabled   Boolean    @default(true)
  sortOrder Int        @default(0)

  @@index([menuId, parentId, sortOrder])
}

model WebsiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Redirect {
  id        String   @id @default(cuid())
  fromPath  String   @unique
  toPath    String
  permanent Boolean  @default(true)
  hits      Int      @default(0)
  createdAt DateTime @default(now())
}

model Lead {
  id             String       @id @default(cuid())
  parentName     String
  phone          String
  email          String
  campusId       String?
  campus         Campus?      @relation(fields: [campusId], references: [id], onDelete: SetNull)
  level          String?
  studentAge     String?      // yaş veya sınıf; yalnızca gerekli asgari bilgi (KVKK veri minimizasyonu)
  message        String?
  source         String       @default("bilgi-talebi") // bilgi-talebi | ziyaret | kampus-formu
  privacyAccepted Boolean
  marketingConsent Boolean    @default(false)
  consentAt      DateTime     @default(now())
  status         LeadStatus   @default(NEW)
  assigneeId     String?
  assignee       User?        @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  locale         String       @default("tr")
  ipHash         String?
  retainUntil    DateTime?    // saklama süresi sonu
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  notes          LeadNote[]
  history        LeadEvent[]

  @@index([status, createdAt])
  @@index([campusId, createdAt])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())
}

model LeadEvent {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String   // created | status | assigned | note | export
  detail    String?
  actorId   String?
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  detail    String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}
